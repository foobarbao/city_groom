# Backend environment variables. Copy to `.env` for local development.
# Never commit the real `.env` (it is git-ignored).

# Secret used by Django for signing. Generate a long random value per
# environment, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Debug mode: true only in local development, never in a deployed environment.
DJANGO_DEBUG=true

# Comma-separated host names the backend answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Redirect HTTP to HTTPS. Defaults to the opposite of DJANGO_DEBUG.
DJANGO_SECURE_SSL_REDIRECT=false

# Comma-separated origins trusted for CSRF (needed for the admin behind HTTPS),
# e.g. https://api.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL + PostGIS connection URL.
# Matches the `db` service of docker-compose.yml when the backend runs on the
# host; inside Docker Compose the host is `db` instead of `localhost`.
DATABASE_URL=postgis://city_groom:city_groom@localhost:5432/city_groom

# Comma-separated origins of the frontends allowed to call the API (CORS),
# e.g. http://localhost:5173,http://localhost:5174
CORS_ALLOWED_ORIGINS=

# Sign in with Google (ADR-0010, docs/GOOGLE_SIGN_IN.md): comma-separated
# OAuth client IDs whose ID tokens are accepted (web client, later Android).
# Public values, not secrets. Empty: sign-in with Google is disabled.
GOOGLE_OAUTH_CLIENT_IDS=

# First administrator created at start-up by scripts/start.sh (hosting only,
# when no shell is available). Remove once the account exists.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=

# API rate limits (DRF format: <number>/<sec|min|hour|day>), see docs/api/README.md.
# Anonymous clients are limited per IP address, users per account, integration
# API keys per key.
API_THROTTLE_ANON=120/min
API_THROTTLE_USER=600/min
API_THROTTLE_API_KEY=600/min
# Sign-in attempts per IP address.
API_THROTTLE_SIGN_IN=20/min
