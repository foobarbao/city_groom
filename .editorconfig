# Shared editor settings, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Trailing double spaces are meaningful line breaks in Markdown
trim_trailing_whitespace = false

[*.{kt,java,gradle}]
indent_size = 4
