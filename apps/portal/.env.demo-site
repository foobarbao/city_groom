# Portal of the hosted demo (npm run build:demo-site): bundled data, no backend.
VITE_DEMO=true
# The customer app is served next to the portal on the demo site.
VITE_CUSTOMER_URL=/client/
# Google OAuth web client ID for the Google Agenda sync (same client as the
# customer sign-in). Public value, safe to commit; Netlify variables also work.
VITE_GOOGLE_CLIENT_ID=117207378216-vt5c3nnldub81khrbd6g5ag9fuc51lju.apps.googleusercontent.com
