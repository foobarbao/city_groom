# Customer app environment variables (Vite exposes only VITE_* variables).
# Copy to `.env.local` for local development. Values are public: they end up
# in the app bundle, so never put secrets here.

# Base URL of the backend API, without trailing slash.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# MapLibre style URL for the map. Free OpenStreetMap-based vector tiles with no
# key, provided without guarantee (ADR-0002).
# PROD: self-host the tiles or use a provider with a service agreement.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
