{
  "name": "@city-groom/customer",
  "version": "0.1.0",
  "private": true,
  "description": "City Groom customer app (Ionic + Capacitor): PWA and Android.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build:demo": "vite build --mode demo",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "build:demo-site": "vite build --mode demo-site"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@city-groom/api-client": "*",
    "@city-groom/demo-data": "*",
    "@city-groom/ui": "*",
    "@fontsource-variable/inter": "^5.3.0",
    "@ionic/vue": "^9.0.9",
    "@ionic/vue-router": "^9.0.9",
    "ionicons": "^8.1.0",
    "maplibre-gl": "^6.15.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/geojson": "^7946.0.16",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "*",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
