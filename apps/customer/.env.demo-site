# Hosted demo site (npm run build:demo-site): bundled fictitious data,
# no backend, live map tiles.
VITE_DEMO=true
# Google OAuth web client ID ("Continuer avec Google", ADR-0010). Public value,
# safe to commit; it can also be set in Netlify's environment variables.
# Empty: the button is shown as "en cours d'activation".
VITE_GOOGLE_CLIENT_ID=117207378216-vt5c3nnldub81khrbd6g5ag9fuc51lju.apps.googleusercontent.com
# Backend used for the Google sign-in (Render behind api.citypal.fr,
# docs/BUILD_AND_RELEASE.md §6). Public value. Its CORS list allows
# citypal.fr, www.citypal.fr and citygroom.netlify.app, so the sign-in fails
# on Netlify deploy previews (other origins).
VITE_API_BASE_URL=https://api.citypal.fr/api/v1
